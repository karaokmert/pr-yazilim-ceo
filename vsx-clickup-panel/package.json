{
  "name": "vsx-clickup-panel",
  "displayName": "ClickUp Task Paneli",
  "description": "ClickUp'ta size atanmis task'lari VS Code icinden goruntuleyin ve statulerini guncelleyin.",
  "version": "0.1.0",
  "publisher": "pr-yazilim",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Eklenti workspace icerigini okumaz veya calistirmaz; yalnizca ClickUp API'siyle konusur."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clickupPanel",
          "title": "ClickUp",
          "icon": "resources/clickup.svg"
        }
      ]
    },
    "views": {
      "clickupPanel": [
        {
          "id": "clickupPanel.tasks",
          "name": "Task'larim"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "clickupPanel.tasks",
        "contents": "ClickUp task'larinizi gormek icin Personal API Token girin.\n[Token Gir](command:clickupPanel.signIn)\n\nToken'i ClickUp > Settings > Apps > API Token bolumunden alabilirsiniz."
      }
    ],
    "commands": [
      {
        "command": "clickupPanel.signIn",
        "title": "ClickUp: Token Gir"
      },
      {
        "command": "clickupPanel.signOut",
        "title": "ClickUp: Token'i Sil"
      },
      {
        "command": "clickupPanel.refresh",
        "title": "ClickUp: Yenile",
        "icon": "$(refresh)"
      },
      {
        "command": "clickupPanel.showTask",
        "title": "ClickUp: Task Detayini Goster"
      },
      {
        "command": "clickupPanel.changeStatus",
        "title": "ClickUp: Statu Degistir",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clickupPanel.refresh",
          "when": "view == clickupPanel.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "clickupPanel.changeStatus",
          "when": "view == clickupPanel.tasks && viewItem == clickupTask",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "clickupPanel.refresh",
          "when": "clickupPanel.signedIn"
        },
        {
          "command": "clickupPanel.signOut",
          "when": "clickupPanel.signedIn"
        },
        {
          "command": "clickupPanel.signIn",
          "when": "!clickupPanel.signedIn"
        },
        {
          "command": "clickupPanel.showTask",
          "when": "false"
        },
        {
          "command": "clickupPanel.changeStatus",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ClickUp Task Paneli",
      "properties": {
        "clickupPanel.teamId": {
          "type": "string",
          "default": "",
          "description": "Task'larin cekilecegi ClickUp Workspace (team) ID. Bos birakilirsa ilk yuklemede secim sorulur."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run package",
    "compile-tests": "tsc --project tsconfig.test.json",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0"
  }
}
