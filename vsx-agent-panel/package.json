{
  "name": "vsx-agent-panel",
  "displayName": "Agent Durum Paneli",
  "description": "Acik Claude Code agent oturumlarini VS Code kenar cubugunda canli listeler.",
  "version": "0.2.0",
  "private": true,
  "publisher": "pryazilim",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/karaokmert/pr-yazilim-ceo.git",
    "directory": "vsx-agent-panel"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Eklenti calisma alanindaki hicbir dosyayi okumaz veya calistirmaz; yalniz kullanicinin kendi ~/.claude/sessions dizinini okur."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Oturum durumu yerel dosya sisteminden (~/.claude/sessions) okunur; sanal calisma alaninda bu dizin yoktur."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsxAgentPanel",
          "title": "Agent Durumu",
          "icon": "resources/agents.svg"
        }
      ]
    },
    "views": {
      "vsxAgentPanel": [
        {
          "id": "vsxAgentPanel.sessions",
          "name": "Acik Oturumlar"
        }
      ]
    },
    "commands": [
      {
        "command": "vsxAgentPanel.refresh",
        "title": "Agent Durumu: Yenile",
        "icon": "$(refresh)"
      },
      {
        "command": "vsxAgentPanel.openFolder",
        "title": "Agent Durumu: Oturum Dizinini Ac"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vsxAgentPanel.refresh",
          "when": "view == vsxAgentPanel.sessions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vsxAgentPanel.openFolder",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "vsxAgentPanel.openFolder",
          "when": "view == vsxAgentPanel.sessions && viewItem == vsxAgentPanel.session",
          "group": "navigation"
        },
        {
          "command": "vsxAgentPanel.openFolder",
          "when": "view == vsxAgentPanel.sessions && viewItem == vsxAgentPanel.project",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Agent Durum Paneli",
      "properties": {
        "vsxAgentPanel.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Dosya izleme disinda yapilan periyodik tazeleme araligi (saniye). Gecen sureyi guncel tutmak icin gereklidir."
        },
        "vsxAgentPanel.staleThresholdMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Bu sureden uzun sessiz kalan oturum 'unutulmus' olarak isaretlenir."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-tests && npm run build",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.24.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0"
  }
}
